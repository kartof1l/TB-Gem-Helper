{
  "manifest_version": 3,
  "name": "Dota2Market TB Gem Helper",
  "version": "3.2",
  "description": "Pokazyvaet prizmaticheskiy samocvet na ikonkah arkany Terrorblade",
  "host_permissions": ["*://market.dota2.net/*"],
  "content_scripts": [
    {
      "matches": ["*://market.dota2.net/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}