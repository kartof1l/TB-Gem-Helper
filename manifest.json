{
  "manifest_version": 3,
  "name": "Dota2Market TB Gem Helper",
  "version": "3.0",
  "description": "Показывает гем внутри арканы Terrorblade",
  "permissions": ["activeTab"],
  "host_permissions": ["*://market.dota2.net/*"],
  "content_scripts": [
    {
      "matches": ["*://market.dota2.net/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}