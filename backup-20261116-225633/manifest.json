{
  "manifest_version": 3,
  "name": "Dota2 Market — Gem Badges",
  "version": "3.1",
  "description": "Показывает призматический самоцвет на иконке лота (аркана Terrorblade и др.)",
  "permissions": ["storage"],
  "host_permissions": ["*://market.dota2.net/*"],
  "content_scripts": [{
    "matches": ["*://market.dota2.net/*"],
    "js": ["gems.js", "content.js"],
    "css": ["styles.css"],
    "run_at": "document_idle"
  }]
}