.gem-badge {
  position: absolute;
  top: 2px;
  left: 2px;
  max-width: calc(100% - 4px);
  padding: 2px 4px;
  border-radius: 3px;
  font: 900 10px/1.1 Arial, sans-serif;
  letter-spacing: .4px;
  text-transform: uppercase;
  text-align: center;
  border: 1px solid rgba(255,255,255,.75);
  box-shadow: 0 1px 3px rgba(0,0,0,.6);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  pointer-events: none;
  z-index: 20;
}
.gem-badge-unknown { border: 1px dashed #ffcc00; }
